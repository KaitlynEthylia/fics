---
layout: common
tags: fic
css: fic
permalink: "/{{ fic }}/{{ title | slugify }}/index.html"
---
		<article>
			<a class="tag" href=".." style="--color:{{ colour }}">{{ fic }}</a>
			<time datetime="{{ date }}">{{ date | date: "%Y-%m-%d" }}</time>
			<h1>{{ title }}</h1>
			{% if contents %}
			<hr/>
			<h2>Table of Contents</h2>
			{{ content | toc: '{"wrapper":"nav","wrapperClass":null}' }}
			{% endif %}
			<hr/>
			{{ content -}}
		</article>
		<hr />
